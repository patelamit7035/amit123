# Copy this file to .env.local and fill it in to run against a real Supabase
# project. Leave it out entirely and the app runs in demo mode, storing
# everything in the visitor's own browser.
#
# Both values come from your Supabase project: Settings -> API.
# The anon key is a public, client-side key by design - row level security is
# what protects the data, not this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed when deploying to a sub-path such as GitHub Pages project sites.
# VITE_BASE_PATH=/amit123/
