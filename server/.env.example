# Meta Marketing API credentials.
# Create an app at https://developers.facebook.com/apps, add the "Marketing API"
# product, and generate a token with ads_management + ads_read permissions
# for the ad account below (a System User token is recommended for long-lived,
# unattended access — see README.md).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0
META_PAGE_ID=
# Landing page the new ad creatives should link to.
META_DESTINATION_URL=https://example.com

# Business/brand context used when the agent writes new ad copy.
BUSINESS_NAME=My Business
PRODUCT_DESCRIPTION=A modern D2C product selling to a broad consumer audience.
BRAND_TONE=bold

# Optional: real AI copywriting. If unset, the agent falls back to a
# template-based copy generator (see src/agent/creativeGenerator.js).
OPENAI_API_KEY=

# Agent behavior
DAILY_CHECK_CRON=0 8 * * *
CREATIVE_ROTATION_CRON=0 9 * * *
CREATIVE_ROTATION_DAYS=3
APPROVAL_MODE=manual
MIN_ROAS_THRESHOLD=1.5
MAX_DAILY_BUDGET_INCREASE_PCT=20
PAUSE_UNDERPERFORMERS=true

# Server
PORT=8787
# Comma-separated list of origins allowed to call this API (your dashboard's URL)
CORS_ORIGIN=*
